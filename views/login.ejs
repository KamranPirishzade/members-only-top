<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: 'Log in' }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page-narrow">
      <h1 class="page-title">Welcome back</h1>
      <p class="page-subtitle mb-6">Log in to your account.</p>

      <form action="/login" method="POST" class="form-card">
        <%- include('partials/formErrors', { errors: error }) %>

        <div class="field">
          <label for="username" class="field-label">Username</label>
          <input type="text" id="username" name="username" value="<%= data.username %>" autocomplete="username" autofocus required class="field-input" />
        </div>

        <div class="field">
          <label for="password" class="field-label">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required class="field-input" />
        </div>

        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </form>

      <p class="form-footer">Don't have an account? <a href="/signup" class="link">Sign up</a></p>
    </main>
  </body>
</html>
