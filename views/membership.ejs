<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> access</title>
  </head>
  <body>
    <h1><%= title %> access</h1>
    <% if(errors.length > 0) { %>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>
    <form action="/membership/<%= title === "Admin" ? "admin" : "join" %>" method="POST">
      <label for="password">Password:</label>
      <input type="password" id="password" name="password" required />
      <br />
      <button type="submit"><%= title %> membership</button>
    </form>
  </body>
</html>
