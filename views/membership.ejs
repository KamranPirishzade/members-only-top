<% const isAdminPage = title === "Admin"; %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: isAdminPage ? 'Admin access' : 'Join the club' }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page-narrow">
      <h1 class="page-title"><%= isAdminPage ? "Admin access" : "Join the club" %></h1>
      <p class="page-subtitle mb-6">
        <%= isAdminPage
          ? "Enter the admin passcode to be able to delete messages."
          : "Enter the club passcode to see who wrote each message and when." %>
      </p>

      <form action="/membership/<%= isAdminPage ? 'admin' : 'join' %>" method="POST" class="form-card">
        <%- include('partials/formErrors') %>

        <div class="field">
          <label for="password" class="field-label">Passcode</label>
          <input type="password" id="password" name="password" autocomplete="off" autofocus required class="field-input" />
        </div>

        <div class="flex justify-end gap-3">
          <a href="/" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary"><%= isAdminPage ? "Become an admin" : "Join the club" %></button>
        </div>
      </form>
    </main>
  </body>
</html>
